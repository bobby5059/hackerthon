# ── backend-api 환경설정 예시 (.env.example) ──
# 실제 운영/실행 시 `.env`로 복사 후 값을 채운다. `.env`는 커밋 금지(.gitignore).

# [필수] JWT HS256 서명키 (BR-AUTH-06: 하드코딩 금지). 충분히 긴 랜덤 문자열.
JWT_SECRET=change-me-to-a-long-random-secret

# JWT 발급자(iss) 및 관리자 토큰 TTL(시간)
JWT_ISSUER=table-order
ADMIN_TOKEN_TTL_HOURS=16

# CORS 허용 오리진(콤마 구분, 와일드카드 금지) — customer :5173 / admin :5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# SQLite 파일 경로
DB_PATH=./table_order.db

# 로그인 rate limit (SECURITY-12): 윈도우 내 최대 실패 횟수 / 윈도우(초) / cooldown(초)
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SEC=300
RATE_LIMIT_COOLDOWN_SEC=300
# rate limiter 인메모리 키 상한(메모리 bound)
RATE_LIMIT_KEY_CAP=10000

# bcrypt cost factor
BCRYPT_COST=12

# 요청 본문 최대 크기(바이트, 기본 1MB)
MAX_BODY_BYTES=1048576

# SQLite busy_timeout(ms)
DB_BUSY_TIMEOUT_MS=5000

# ── 시드 스크립트용(app/db/seed.py) ──
# 시드 매장/관리자 정보. 관리자 비밀번호는 최소 8자(SECURITY-12).
SEED_STORE_ID=store-001
SEED_STORE_NAME=샘플 매장
SEED_ADMIN_USERNAME=manager
SEED_ADMIN_PASSWORD=change-me-8chars
